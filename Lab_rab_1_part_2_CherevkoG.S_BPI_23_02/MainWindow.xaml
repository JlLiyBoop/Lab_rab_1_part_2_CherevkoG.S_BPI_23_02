<Window x:Class="Lab_rab_1_part_2_CherevkoG.S_BPI_23_02.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab_rab_1_part_2_CherevkoG.S_BPI_23_02"
        mc:Ignorable="d"
        Title="MainWindow" Height="400" Width="600" MinHeight="320" MinWidth="500" MaxHeight="450" MaxWidth="800">

    <Window.Resources>
        <Style x:Key="LightTheme" TargetType="Control">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
        </Style>

        <Style x:Key="DarkTheme" TargetType="Control">
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="Foreground" Value="#FFD0D0D0"/>
            <Setter Property="BorderBrush" Value="#FF3E3E42"/>
        </Style>

        <Style x:Key="ThemeToggleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FF005A9E"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF1C97EA"/>
                    <Setter Property="BorderBrush" Value="#FF007ACC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FF1E1E1E"/>
            <Setter Property="Foreground" Value="#FFD0D0D0"/>
            <Setter Property="BorderBrush" Value="#FF3E3E42"/>
            <Setter Property="CaretBrush" Value="#FFD0D0D0"/>
            <Setter Property="SelectionBrush" Value="#FF007ACC"/>
        </Style>
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#FF1E1E1E"/>
            <Setter Property="Foreground" Value="#FFD0D0D0"/>
            <Setter Property="BorderBrush" Value="#FF3E3E42"/>
        </Style>
        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF333337"/>
            <Setter Property="Foreground" Value="#FFD0D0D0"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF46464A"/>
                    <Setter Property="BorderBrush" Value="#FF666666"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20" Name="MainGrid" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                Name="ThemeToggleButton" Content="Темная тема" 
                Style="{StaticResource ThemeToggleButtonStyle}"
                HorizontalAlignment="Right" Click="ThemeToggleButton_Click"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Тип функции:" 
                   Margin="0,10,10,10" VerticalAlignment="Center" Name="TypeFuncText"/>
        <ComboBox Grid.Row="1" Grid.Column="1" Name="typefunc"
                  Margin="0,10,0,10" SelectionChanged="Typefunc_SC">
            <ComboBoxItem Content="Натуральный логарифм" Tag="Ln"/>
            <ComboBoxItem Content="Логарифм" Tag="Log"/>
        </ComboBox>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Основание:" 
                   Margin="0,0,10,10" VerticalAlignment="Center" Name="osn"/>
        <TextBox Grid.Row="2" Grid.Column="1" Name="osntext" 
                 Margin="0,0,0,10" Text="10" IsEnabled="False"  TextChanged="Osntext_TextChanged"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Значение x:" 
                   Margin="0,0,10,10" VerticalAlignment="Center" Name="XValueText"/>
        <TextBox Grid.Row="3" Grid.Column="1" Name="xtext" 
                 Margin="0,0,0,10" Text="0"/>

        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center"
                    Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Button Name="schetButton" Content="Вычислить функцию"
                    Width="150" Height="30" Margin="0,0,10,0" Click="schet_Click"/>
            <Button Name="proizvButton" Content="Вычислить производную" 
                    Width="150" Height="30" Click="proizv_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Информация:" 
                   Margin="0,0,10,10" VerticalAlignment="Center" Name="InfoText"/>
        <TextBox Grid.Row="5" Grid.Column="1" Name="infotext" 
                 Margin="0,0,0,10" Height="90" IsReadOnly="True" 
                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Результат:" 
                   Margin="0,0,10,10" VerticalAlignment="Center" Name="ResultText"/>
        <TextBox Grid.Row="6" Grid.Column="1" Name="resulttext" 
                 Margin="0,0,0,10" Height="90" IsReadOnly="True" 
                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
    </Grid>
</Window>